model UserCredentials {
    id              String @id @default(uuid())
    email           String @unique
    username        String @unique
    password_hash   String

    user_role       String @default("user")

    profile         UserProfile?
}

model UserProfile {
    id              String @id

    displayName     String?
    avatar_url      String?
    bio             String?

    user            UserCredentials @relation(fields: [id], references: [id], onDelete: Cascade)
    followers       UserFollowing[] @relation("Followee") //who follows me
    following       UserFollowing[] @relation("Follower")  //who I follow
    artist          Artist? //user can also be an artist
}

model UserFollowing {
    follower_id     String
    followee_id     String
    created_at      DateTime @default(now())

    @@id([follower_id, followee_id])

    follower        UserProfile @relation("Follower", fields: [follower_id], references: [id], onDelete: Cascade)
    followee        UserProfile @relation("Followee", fields: [followee_id], references: [id], onDelete: Cascade)
}